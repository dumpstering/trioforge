{% extends "base.html.j2" %}
{% block main %}
<main id="main" tabindex="-1" class="wrap prose" data-page="notfound">
<h1>Page not found</h1>
<p class="lead">There is nothing at this address. The page may have moved, or the link may have a mistake in it.</p>
<p><a href="/">Go to the home page</a></p>
{% if live %}
<h2>Pages you can open</h2>
<ul class="cards">
{% for trio in live %}
<li><a href="/trio/{{ trio.slug }}/">{{ trio.name }}: best gear (level {{ trio.level }})</a></li>
{% endfor %}
</ul>
{% endif %}
</main>
{% endblock %}
