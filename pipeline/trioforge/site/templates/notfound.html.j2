{% extends "base.html.j2" %}
{#- This page is sent, with a 404, for every address the site has no file for, so it names none. Its script (notfound.js) moves a trio address in another order, case or form to the page of the
    trio, from the list in data-trios, and has a hint to show for the addresses of an item or a trio that lead nowhere. It replaces the page script of the frame: the code that takes a kit link
    out of the address stays out of this page, and so does any analytics beacon, which its own policy (a meta element in the head, which adds to the header's: no script of another site, no
    connection of any kind) would refuse as well. build.NOTFOUND_POLICY is that policy, and check_budgets requires it. -#}
{% block page_script %}
<script type="module" src="{{ assets.notfound }}"></script>
{% endblock %}
{% block head_policy %}
<meta http-equiv="Content-Security-Policy" content="script-src 'self'; connect-src 'none'">
{% endblock %}
{% block main %}
<main id="main" tabindex="-1" class="wrap prose" data-page="notfound" data-trios="{{ live|map(attribute='slug')|join(' ') }}">
<h1>Page not found</h1>
{% if art.has("lost") %}
<span class="art art-lost" aria-hidden="true"></span>
{% endif %}
<p class="lead">There is nothing at this address. The page may have moved, or the link may have a mistake in it.</p>
<p id="notfound-hint" class="note" hidden></p>
<p><a href="/">Go to the home page</a></p>
{% if listed %}
<h2>Pages you can open</h2>
<ul class="cards">
{% for trio in live %}
<li><a href="/trio/{{ trio.slug }}/">{{ trio.name }}: best gear (level {{ trio.level }})</a></li>
{% endfor %}
</ul>
{% endif %}
</main>
{% endblock %}
