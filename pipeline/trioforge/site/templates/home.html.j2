{% extends "base.html.j2" %}
{% block main %}
<main id="main" tabindex="-1" class="wrap home" data-page="home">
<h1>Best gear for every class trio</h1>
<p class="lead">Pick three classes and see the one kit to wear: exact answers for EverQuest Legends, with the evidence and the confidence behind every rule. TrioForge is a fan project.</p>
<section aria-labelledby="live-h">
<h2 id="live-h">Live now</h2>
<ul id="live-trios" class="cards">
{% for trio in live %}
<li><a href="/trio/{{ trio.slug }}/">{{ trio.name }}: best gear (level {{ trio.level }})</a></li>
{% endfor %}
</ul>
<p>Every other trio is coming soon.</p>
</section>
<section aria-labelledby="pick-h">
<h2 id="pick-h">Pick your three classes</h2>
<div id="picker" hidden data-live="{{ live|map(attribute='slug')|join(' ') }}">
<fieldset class="chips">
<legend>Classes (choose three)</legend>
{% for cls in classes %}
<span class="chip"><input type="checkbox" id="class-{{ cls.code }}" value="{{ cls.code }}"><label for="class-{{ cls.code }}">{{ cls.name }}</label></span>
{% endfor %}
</fieldset>
<p id="picker-status" role="status" aria-live="polite">Pick three classes.</p>
</div>
</section>
</main>
{% endblock %}
